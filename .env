# ─────────────────────────────────────────────────────────────
# RideShare platform - docker compose settings
# `docker compose up -d --build` reads this file automatically.
# ─────────────────────────────────────────────────────────────

# Shared secret used by auth-service (signs JWTs) and api-gateway (verifies them). >= 32 chars.

JWT_SECRET=dev-only-rideshare-jwt-secret-change-me-0123456789

# MySQL root password (app / replication / exporter users are created by docker/mysql/init/00-*.sql)

MYSQL_ROOT_PASSWORD=root_pw

# ── Grafana ──────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Alert e-mails are delivered to this address (visible in Mailpit at http://localhost:8025)
ALERT_EMAIL_TO=shimdi247@gmail.com
# SMTP used by Grafana-managed alerts. Defaults point to the bundled Mailpit catch-all server.
# To use a real provider change these (and set SMTP_STARTTLS to OpportunisticStartTLS or MandatoryStartTLS).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=chimdi247@gmail.com
SMTP_PASSWORD=
SMTP_FROM=chimdi247@gmail.com
SMTP_STARTTLS=MandatoryStartTLS

# ── Frontend map / routing ───────────────────────────────────
# Initial map centre (Bangalore matches the sample data of the original project)

MAP_CENTER_LAT=12.9716
MAP_CENTER_LNG=77.5946
MAP_ZOOM=13
# Raster tiles (any XYZ tile server). The public OSM server is fine for development only.

MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# Address search (Nominatim). Public instance: max 1 request/second, development use only.
GEOCODER_URL=https://nominatim.openstreetmap.org

# Routing engine behind the frontend's /osrm/ path (OSRM = Open Source Routing Machine)
#  a) default: public OSRM demo server (zero setup, no SLA)
OSRM_UPSTREAM=https://router.project-osrm.org
OSRM_HOST_HEADER=router.project-osrm.org

#  b) self-hosted: start with `docker compose --profile osrm up -d`, and set
#       OSRM_UPSTREAM=http://osrm:5000
#       OSRM_HOST_HEADER=osrm
#     plus the OpenStreetMap extract that covers your map centre (https://download.geofabrik.de):

OSRM_PBF_URL=https://download.geofabrik.de/asia/india/southern-zone-latest.osm.pbf
#     e.g. Nigeria: https://download.geofabrik.de/africa/nigeria-latest.osm.pbf

# ── Published host ports ─────────────────────────────────────
FRONTEND_PORT=8088
