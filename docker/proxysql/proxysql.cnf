# ProxySQL: connection pooling / multiplexing + read/write split + load balancing.
#   hostgroup 10 = writer (mysql-primary)
#   hostgroup 20 = readers (mysql-replica, plus the primary as a fallback)
# The monitor moves servers between groups based on read_only, so a promoted replica is detected.
datadir="/var/lib/proxysql"
errorlog="/var/lib/proxysql/proxysql.log"

admin_variables=
{
    admin_credentials="admin:admin;radmin:radmin"
    mysql_ifaces="0.0.0.0:6032"
    # Built-in Prometheus exporter -> http://proxysql:6070/metrics
    restapi_enabled=true
    restapi_port=6070
    prometheus_memory_metrics_interval=61
}

mysql_variables=
{
    threads=4
    max_connections=2048
    interfaces="0.0.0.0:6033"
    server_version="8.0.36"
    default_schema="uberapp"
    stacksize=1048576
    poll_timeout=2000
    connect_timeout_server=3000
    connect_retries_on_failure=10
    ping_interval_server_msec=120000
    ping_timeout_server=500
    commands_stats=true
    sessions_sort=true
    multiplexing=true
    free_connections_pct=10
    monitor_username="proxysql_monitor"
    monitor_password="proxysql_monitor_pw"
    monitor_connect_interval=5000
    monitor_ping_interval=5000
    monitor_read_only_interval=1500
    monitor_read_only_timeout=500
    monitor_replication_lag_interval=5000
    monitor_writer_is_also_reader=true
}

mysql_servers=
(
    { address="mysql-primary", port=3306, hostgroup=10, max_connections=200, max_replication_lag=10, weight=1000, comment="primary" },
    { address="mysql-replica", port=3306, hostgroup=20, max_connections=200, max_replication_lag=10, weight=1000, comment="replica" }
)

mysql_replication_hostgroups=
(
    { writer_hostgroup=10, reader_hostgroup=20, check_type="read_only", comment="uberapp" }
)

mysql_users=
(
    { username="uber_app", password="uber_app_pw", default_hostgroup=10, active=1, transaction_persistent=1, max_connections=1000 }
)

# Only statements explicitly tagged by the application (Hibernate query comment "route:reader")
# are sent to the readers. Everything else - including SELECT ... FOR UPDATE and every write -
# stays on the primary, which avoids stale reads inside write paths.
mysql_query_rules=
(
    { rule_id=1, active=1, match_pattern="^/[*] route:reader [*]/", destination_hostgroup=20, apply=1, comment="read-only queries tagged by the app" }
)
